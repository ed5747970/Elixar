<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<!-- Elixar starts with your normal rights and asks for administrator rights itself. Having a manifest also makes
     Windows ignore an "Elixar.exe.local" folder, which could otherwise redirect the DLLs Elixar loads. -->
<assembly xmlns="urn:schemas-microsoft-com:asm.v1" manifestVersion="1.0">
  <assemblyIdentity version="1.0.0.0" name="Elixar.app"/>
  <trustInfo xmlns="urn:schemas-microsoft-com:asm.v2">
    <security>
      <requestedPrivileges xmlns="urn:schemas-microsoft-com:asm.v3">
        <requestedExecutionLevel level="asInvoker" uiAccess="false"/>
      </requestedPrivileges>
    </security>
  </trustInfo>
</assembly>
